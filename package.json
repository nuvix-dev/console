{
  "name": "nuvix-console",
  "version": "0.0.1",
  "private": true,
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "biome format --write ./"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@nuvix/eslint-config": "workspace:*",
    "@nuvix/typescript-config": "workspace:*",
    "turbo": "latest",
    "typescript": "5.8.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "onlyBuiltDependencies": [
    "@biomejs/biome",
    "@parcel/watcher",
    "core-js-pure",
    "esbuild",
    "sharp"
  ],
  "ignoredBuiltDependencies": [
    "@tailwindcss/oxide",
    "unrs-resolver"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
